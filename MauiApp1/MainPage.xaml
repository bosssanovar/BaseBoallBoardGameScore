<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <Grid x:Name="BoardContainer"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          Padding="5"
          BackgroundColor="Black">

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左上 -->
        <Border Grid.Row="0" Grid.Column="0"
                StrokeThickness="0" Background="#1f1f1f" Margin="3"/>

        <!-- 中央上（スコア表） -->
        <Border Grid.Row="0" Grid.Column="1"
                StrokeThickness="0" Background="#1f1f1f" Margin="3">

            <Grid Margin="15" ColumnSpacing="5" RowSpacing="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 見出し -->
                <Border Grid.Row="0" Grid.Column="1" Background="Black">
                    <Label Text="1" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" Background="Black">
                    <Label Text="2" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="3" Background="Black">
                    <Label Text="3" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="4" Background="Black">
                    <Label Text="合計" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>

                <!-- プレイヤー1 -->
                <Border Grid.Row="1" Grid.Column="0"
                        Background="{x:Binding OmotePlayerBackground.Value}">
                    <Label Text="プレイヤー1" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Background="Black">
                    <Label Text="{x:Binding Omote1Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Background="Black">
                    <Label Text="{x:Binding Omote2Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="3" Background="Black">
                    <Label Text="{x:Binding Omote3Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="4" Background="Black">
                    <Label Text="{x:Binding OmoteTotalScore.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>

                <!-- プレイヤー2 -->
                <Border Grid.Row="2" Grid.Column="0"
                        Background="{x:Binding UraPlayerBackground.Value}">
                    <Label Text="プレイヤー2" HorizontalOptions="Center" VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>

                <Border Grid.Row="2" Grid.Column="1" Background="Black">
                    <Label Text="{x:Binding Ura1Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Background="Black">
                    <Label Text="{x:Binding Ura2Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="3" Background="Black">
                    <Label Text="{x:Binding Ura3Score.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="4" Background="Black">
                    <Label Text="{x:Binding UraTotalScore.Value}" HorizontalOptions="Center"
                           VerticalOptions="Center"
                           FontSize="{OnPlatform Android=30, WinUI=30}" TextColor="White"/>
                </Border>
            </Grid>
        </Border>

        <!-- 初期化ボタン -->
        <Border Grid.Row="0" Grid.Column="2"
                StrokeThickness="0" Background="#1f1f1f" Margin="3">
            <Grid RowSpacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Grid.Row="0"
                        Text="初期化" Padding="40,20" HorizontalOptions="Center" VerticalOptions="Center"
                        BackgroundColor="#550000" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding InitializeCommand}" />
                <Button Grid.Row="2"
                        Text="戻す" Padding="40,20" HorizontalOptions="Center" VerticalOptions="Center"
                        BackgroundColor="#888888" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding UndoCommand}" />
            </Grid>
        </Border>

        <!-- 左下（ボタン群） -->
        <Border Grid.Row="1" Grid.Column="0"
                StrokeThickness="0" Background="#1f1f1f" Margin="3">

            <Grid RowSpacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Text="ボール" Padding="40,20"
                        BackgroundColor="#5555aa" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding BallCommand}" />

                <Button Grid.Row="1" Text="ストライク" Padding="40,20"
                        BackgroundColor="#aaaa22" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding StrikeCommand}" />
                
                <Button Grid.Row="2" Text="アウト" Padding="40,20"
                        BackgroundColor="#aa5555" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding OutCommand}" />

                <Button Grid.Row="4" Text="ファール" Padding="40,20"
                        BackgroundColor="#000055" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding FoulCommand}" />
            </Grid>
        </Border>

        <!-- 中央下（ベース表示） -->
        <Border Grid.Row="1" Grid.Column="1"
                StrokeThickness="0" Background="#1f1f1f" Margin="3">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="1" Grid.Row="0"
                           Background="{x:Binding Base2Brush.Value}"
                           WidthRequest="40" HeightRequest="40"
                           Margin="20" Rotation="45"/>

                <Rectangle Grid.Column="0" Grid.Row="1"
                           Background="{x:Binding Base3Brush.Value}"
                           WidthRequest="40" HeightRequest="40"
                           Margin="50" Rotation="45"/>

                <Rectangle Grid.Column="2" Grid.Row="1"
                           Background="{x:Binding Base1Brush.Value}"
                           WidthRequest="40" HeightRequest="40"
                           Margin="20" Rotation="45"/>

                <Rectangle Grid.Column="1" Grid.Row="2"
                           Background="White"
                           WidthRequest="40" HeightRequest="40"
                           Margin="20" Rotation="45"/>

                <!-- ボール・ストライク・アウト表示 -->
                <Grid Grid.Column="1" Grid.Row="1"
                      Margin="{OnPlatform Android=40, WinUI=40}"
                      HorizontalOptions="Start" VerticalOptions="End"
                      ColumnSpacing="5" RowSpacing="5">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Text="ボール"
                           FontSize="{OnPlatform Android=25, WinUI=30}" TextColor="#5555aa"
                           Margin="0,0,20,0"/>

                    <Ellipse Grid.Column="1" Grid.Row="0"
                             IsVisible="{x:Binding Ball1Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#5555aa"/>

                    <Ellipse Grid.Column="2" Grid.Row="0"
                             IsVisible="{x:Binding Ball2Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#5555aa"/>

                    <Ellipse Grid.Column="3" Grid.Row="0"
                             IsVisible="{x:Binding Ball3Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#5555aa"/>

                    <Label Grid.Column="0" Grid.Row="1" Text="ストライク"
                           FontSize="{OnPlatform Android=25, WinUI=30}" TextColor="#aaaa22"
                           Margin="0,0,20,0"/>

                    <Ellipse Grid.Column="1" Grid.Row="1"
                             IsVisible="{x:Binding Strike1Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#aaaa22"/>

                    <Ellipse Grid.Column="2" Grid.Row="1"
                             IsVisible="{x:Binding Strike2Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#aaaa22"/>

                    <Label Grid.Column="0" Grid.Row="2" Text="アウト"
                           FontSize="{OnPlatform Android=25, WinUI=30}" TextColor="#aa5555"
                           Margin="0,0,20,0"/>

                    <Ellipse Grid.Column="1" Grid.Row="2"
                             IsVisible="{x:Binding Out1Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#aa5555"/>

                    <Ellipse Grid.Column="2" Grid.Row="2"
                             IsVisible="{x:Binding Out2Visibility.Value}"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="#aa5555"/>
                </Grid>

                <Image x:Name="Ball" Source="baseball_ball.png" WidthRequest="30" HeightRequest="30"
                           Grid.Column="1" Grid.Row="2" Opacity="0"/>

                <Image x:Name="HomeRunner" Source="runner_right.png" WidthRequest="80" HeightRequest="80"
                           Grid.Column="1" Grid.Row="2" Opacity="0"/>
                <Image x:Name="Base1Runner" Source="runner_left.png" WidthRequest="80" HeightRequest="80"
                           Grid.Column="2" Grid.Row="1" Opacity="0"/>
                <Image x:Name="Base2Runner" Source="runner_left.png" WidthRequest="80" HeightRequest="80"
                           Grid.Column="1" Grid.Row="0" Opacity="0"/>
                <Image x:Name="Base3Runner" Source="runner_right.png" WidthRequest="80" HeightRequest="80"
                           Grid.Column="0" Grid.Row="1" Opacity="0"/>
            </Grid>
        </Border>

        <!-- 右下（ヒットボタン群） -->
        <Border Grid.Row="1" Grid.Column="2"
                StrokeThickness="0" Background="#1f1f1f" Margin="3">

            <Grid RowSpacing="10" VerticalOptions="Center" HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Text="シングルヒット" Padding="40,20"
                        BackgroundColor="#000055" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding SingleHitCommand}" />

                <Button Grid.Row="1" Text="2ベースヒット" Padding="40,20"
                        BackgroundColor="#000055" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding TwoBaseHitCommand}" />

                <Button Grid.Row="2" Text="3ベースヒット" Padding="40,20"
                        BackgroundColor="#000055" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding ThreeBaseHitCommand}" />

                <Button Grid.Row="3" Text="ホームラン" Padding="40,20"
                        BackgroundColor="#000055" TextColor="White"
                        FontSize="{OnPlatform Android=20, WinUI=25}"
                        Command="{x:Binding HomeRunCommand}" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
