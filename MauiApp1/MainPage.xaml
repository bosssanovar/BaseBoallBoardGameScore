<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage">

    <Grid x:Name="BoardContainer" BackgroundColor="Black"
          WidthRequest="1120" HeightRequest="630">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0"
                StrokeThickness="0" Background="#252525" Margin="5">
            
        </Border>

        <Border Grid.Row="0" Grid.Column="1"
                StrokeThickness="0" Background="#252525" Margin="5">
            
        </Border>

        <Border Grid.Row="0" Grid.Column="2"
                StrokeThickness="0" Background="#252525" Margin="5">
            
        </Border>

        <Border Grid.Row="1" Grid.Column="0"
                StrokeThickness="0" Background="#252525" Margin="5">
            
        </Border>

        <Border Grid.Row="1" Grid.Column="1"
                StrokeThickness="0" Background="#252525" Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="1" Grid.Row="0" Background="#363636"
                           WidthRequest="50" HeightRequest="50" Margin="20"
                           Rotation="45"/>

                <Rectangle Grid.Column="0" Grid.Row="1" Background="#363636"
                           WidthRequest="50" HeightRequest="50" Margin="20"
                           Rotation="45"/>

                <Rectangle Grid.Column="2" Grid.Row="1" Background="#363636"
                           WidthRequest="50" HeightRequest="50" Margin="20"
                           Rotation="45"/>

                <Rectangle Grid.Column="1" Grid.Row="2" Background="White"
                           WidthRequest="50" HeightRequest="50" Margin="20"
                           Rotation="45"/>

                <Grid Grid.Column="1" Grid.Row="1"
                      HorizontalOptions="Center" VerticalOptions="End"
                      ColumnSpacing="5" RowSpacing="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" HorizontalOptions="End"
                           Text="ボール" FontSize="30" Margin="0,0,20,0"/>
                    <Ellipse Grid.Column="1" Grid.Row="0"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="White"/>
                    <Ellipse Grid.Column="2" Grid.Row="0"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="White"/>
                    <Ellipse Grid.Column="3" Grid.Row="0"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="White"/>

                    <Label Grid.Column="0" Grid.Row="1" HorizontalOptions="End"
                           Text="ストライク" FontSize="30" Margin="0,0,20,0"/>
                    <Ellipse Grid.Column="1" Grid.Row="1"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="White"/>
                    <Ellipse Grid.Column="2" Grid.Row="1"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="White"/>

                    <Label Grid.Column="0" Grid.Row="2" HorizontalOptions="End"
                           Text="アウト" FontSize="30" Margin="0,0,20,0"/>
                    <Ellipse Grid.Column="1" Grid.Row="2"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="Red"/>
                    <Ellipse Grid.Column="2" Grid.Row="2"
                             HorizontalOptions="Center" VerticalOptions="Center"
                             WidthRequest="30" HeightRequest="30"
                             BackgroundColor="Red"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="2"
                StrokeThickness="0" Background="#252525" Margin="5">
            
        </Border>
    </Grid>

</ContentPage>
